{
  "schema": "x402inc.billing-rules/v0",
  "_schema_note": "SELF-DEFINED schema (UNVERIFIED). This is x402 Inc.'s declarative source of truth for which paths are paid, how much, in what currency, on what network. It is deliberately implementation-independent so it can later be mapped onto Cloudflare Monetization Gateway rules (mapping is PENDING-B). Field names intentionally do NOT mimic any unpublished Cloudflare Gateway terminology.",
  "defaults": {
    "currency": "USDC",
    "network": "base",
    "payTo": "0x0000000000000000000000000000000000000000",
    "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
    "assetDecimals": 6,
    "maxTimeoutSeconds": 60,
    "scheme": "exact"
  },
  "rules": [
    {
      "id": "data-fetch-basic",
      "match": { "pathExact": "/v1/data", "methods": ["GET"] },
      "price": { "amount": "0.010", "currency": "USDC" },
      "useCase": "data-fetch"
    },
    {
      "id": "search-query",
      "match": { "pathPrefix": "/v1/search", "methods": ["GET", "POST"] },
      "price": { "amount": "0.025", "currency": "USDC" },
      "useCase": "search"
    },
    {
      "id": "financial-quote",
      "match": { "pathExact": "/v1/finance/quote", "methods": ["GET"] },
      "price": { "amount": "0.100", "currency": "USDC" },
      "network": "base",
      "useCase": "financial-data"
    }
  ]
}
